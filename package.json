{
  "name": "iconic-shirts-coa-manager",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --config dev --tunnel-url https://paleozoological-apperceptively-camden.ngrok-free.dev:3001 --store=test-1-111111111111111156.myshopify.com",
    "deploy:dev": "shopify app deploy --config dev",
    "deploy:prod": "shopify app deploy --config production",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:ui": "vitest run --project ui",
    "import:legacy": "tsx --env-file=.env scripts/import-legacy.script.ts",
    "sync:retry": "tsx --env-file-if-exists=.env scripts/sync-retry.script.ts",
    "proxy:sign": "tsx --env-file=.env scripts/proxy-sign.script.ts",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-api": "15.0.0",
    "@shopify/shopify-app-react-router": "^3.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "7.18.2",
    "tsx": "^4.23.15",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/polaris-types": "~1.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql": "~16.14",
    "graphql-config": "^5.1.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "~3.2.7"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  },
  "author": "macbook"
}
